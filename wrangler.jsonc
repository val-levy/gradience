{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "impact-perps",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
